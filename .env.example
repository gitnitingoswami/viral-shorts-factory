# Copy to .env for local development. Never commit .env.
# Values below are local-only placeholders; production values come from the secret manager.

NODE_ENV=development
PORT=3100
APP_VERSION=0.1.0
LOG_LEVEL=info
# Comma-separated origins allowed to call the API (Angular dev server).
CORS_ORIGINS=http://localhost:4200

# PostgreSQL
DB_HOST=localhost
DB_PORT=55432
DB_USER=vsf
DB_PASSWORD=vsf_local_only
DB_NAME=vsf

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=56379
QUEUE_PREFIX=vsf

# S3-compatible storage (SeaweedFS locally; S3 or an S3-compatible gateway in cloud)
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vsf-media
STORAGE_ACCESS_KEY=vsf_local_access
STORAGE_SECRET_KEY=vsf_local_secret_only
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=true

# Auth. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Set false only for local http (non-TLS) development.
COOKIE_SECURE=false

# One-time owner bootstrap (used only when no users exist). Clear after first run.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Swagger UI at /api/docs (always disabled when NODE_ENV=production)
SWAGGER_ENABLED=true
